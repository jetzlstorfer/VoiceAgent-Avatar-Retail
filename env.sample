# Environment variables for Voice Agent Avatar Retail sample application.
# copy this file to .env and fill in the values before running the application.

# AZURE_VOICE_LIVE_ENDPOINT is the endpoint of your Azure Voice Live resource, e.g. https://your-resource-name.cognitiveservices.azure.com/
AZURE_VOICE_LIVE_ENDPOINT=

VOICE_LIVE_MODEL=gpt-realtime
AZURE_OPENAI_API_KEY=
AZURE_VOICE_AVATAR_CHARACTER=

# Foundry Agent — used as a tool for product knowledge QnA (Responses API)
# When set, the perform_search_based_qna tool calls this agent instead of Azure AI Search directly.
# Format: https://<resource>.services.ai.azure.com/api/projects/<project>/applications/<agent>/protocols/openai/responses?api-version=2025-11-15-preview
AZURE_AGENT_ENDPOINT=

AZURE_VOICE_AVATAR_CUSTOMIZED=false
AZURE_VOICE_AVATAR_WIDTH=640
AZURE_VOICE_AVATAR_HEIGHT=360
AZURE_VOICE_AVATAR_BITRATE=800000

# Voice source selection – controls which TTS voice is used for speech output.
#   avatar   : Use a standard Azure TTS voice for the avatar (the avatar lip-syncs
#              to this voice). Same behaviour as the Speech Studio playground.
#   custom   : Use a custom neural voice (requires AZURE_CUSTOM_VOICE_ENDPOINT_ID_EN/DE below).
#   standard : Use a standard Azure TTS voice (AZURE_TTS_VOICE below).
#   auto     : (default) Use custom voice if an endpoint ID is configured, otherwise standard.
AZURE_VOICE_SOURCE=auto

# TTS voice name — used by 'avatar', 'standard', and 'auto' sources.
AZURE_TTS_VOICE=en-US-AndrewMultilingualNeural
# German TTS voice – used when no custom voice endpoint is configured for German
AZURE_TTS_VOICE_DE=de-DE-ConradNeural

# Custom Voice Configuration (optional)
# When set, the corresponding language will use your deployed custom neural voice
# instead of the standard Azure voice above.
# Set these to the deployment/endpoint ID (GUID) from your custom voice deployment.
# Example: 53ab1886-782f-437b-9d19-becaffa3939f^
# Voice must be availalbe in same region as AZURE_VOICE_LIVE_ENDPOINT
AZURE_CUSTOM_VOICE_ENDPOINT_ID_EN=
AZURE_CUSTOM_VOICE_ENDPOINT_ID_DE=

# Logic App webhook endpoints
LOGIC_APP_URL_SHIPMENT_ORDERS=
LOGIC_APP_URL_CALL_LOG_ANALYSIS=

# The following variables are used for deployment and containerization of the application.

# Comma-separated list of allowed CORS origins. Leave empty for wildcard (*) in development.
# Example: https://myapp.example.com,https://staging.example.com
ALLOWED_ORIGINS=

# Session idle timeout in seconds (default 1800 = 30 minutes). Sessions inactive
# longer than this are automatically reaped.
SESSION_TTL_SECONDS=1800

RESOURCE_GROUP=
CONTAINER_APP_NAME=
CONTAINER_REGISTRY=
IMAGE_NAME=
# Optional. Leave empty to auto-generate an immutable tag on each deploy.
# Avoid using 'latest' for production deployments.
TAG=
# Optional prefix when TAG is auto-generated.
TAG_PREFIX=build
# Optional. Set true to also push IMAGE_NAME:latest as a compatibility alias.
PUSH_LATEST_ALIAS=false
# REGION where to deploy the application. Not necessarily the same as the region of your Azure Voice Live resource
REGION=