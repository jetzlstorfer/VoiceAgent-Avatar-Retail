AZURE_VOICE_LIVE_ENDPOINT=

RESOURCE_GROUP=
CONTAINER_APP_NAME=
CONTAINER_REGISTRY=
IMAGE_NAME=
# Optional. Leave empty to auto-generate an immutable tag on each deploy.
# Avoid using 'latest' for production deployments.
TAG=
# Optional prefix when TAG is auto-generated.
TAG_PREFIX=build
# Optional. Set true to also push IMAGE_NAME:latest as a compatibility alias.
PUSH_LATEST_ALIAS=false
REGION=

VOICE_LIVE_MODEL=
AZURE_OPENAI_API_KEY=
AZURE_VOICE_AVATAR_CHARACTER=
AZURE_VOICE_AVATAR_CUSTOMIZED=false
AZURE_VOICE_AVATAR_WIDTH=
AZURE_VOICE_AVATAR_HEIGHT=
AZURE_VOICE_AVATAR_BITRATE=
AZURE_TTS_VOICE=
# azure-standard: uses standalone Neural TTS via AZURE_TTS_VOICE.
# Voice type for the Voice Live session:
#   azure-standard  – Azure Neural TTS voice (set AZURE_TTS_VOICE)
#   azure-custom    – Custom Neural Voice (requires AZURE_VOICE_ENDPOINT_ID)
#   azure-personal  – Personal voice trained with your custom avatar in Foundry
#                     (requires AZURE_PERSONAL_VOICE_NAME)
#   azure-avatar    – Convenience alias: auto-selects azure-personal if
#                     AZURE_PERSONAL_VOICE_NAME is set, azure-custom if
#                     AZURE_VOICE_ENDPOINT_ID is set, else azure-standard.
AZURE_VOICE_TYPE=azure-standard

# Personal voice name from Azure AI Foundry (for azure-personal / azure-avatar).
# Find this in your Foundry project → Speech → Personal Voice.
AZURE_PERSONAL_VOICE_NAME=
# Neural model for personal voice: DragonLatestNeural or DragonHDOmniLatestNeural
AZURE_PERSONAL_VOICE_MODEL=DragonLatestNeural

# Custom voice endpoint ID (GUID) from Speech Studio (for azure-custom / azure-avatar).
AZURE_VOICE_ENDPOINT_ID=
